{
  "name": "bucle-studio-site",
  "version": "2.0.0",
  "private": true,
  "description": "Bucle Studio — architecture & interior design practice site (San Salvador, El Salvador).",
  "scripts": {
    "dev": "http-server -c-1 -p 5173",
    "start": "http-server -c-1 -p 5173",
    "sync": "node scripts/sync-site.mjs",
    "sync:check": "node scripts/sync-site.mjs --check",
    "images": "node scripts/optimize-images.mjs",
    "images:force": "node scripts/optimize-images.mjs --force",
    "markdown": "node scripts/build-markdown.mjs",
    "build": "npm run images && npm run markdown && npm run sync",
    "test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3"
  }
}
